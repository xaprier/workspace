---
// Hub's Tech Stack section (Identity & Polish nav pass): categorized
// technology lists sourced from the Framing Statement's optional
// techStack field — a category label (same muted-accent section-label
// language as the Hub's top-level section labels, at a sub-level) plus
// a row of registry-backed TechBadges per category. Per the
// long-standing no-percentage-bars rule, no proficiency indicator of
// any kind — presence in a category is the entire signal, evaluated the
// same way Workbench was: a categorized list, not a skill-bar widget or
// any other simulated-credential chrome.
import TechBadge from './TechBadge.astro';

interface Props {
  techStack: { category: string; items: string[] }[];
}

const { techStack } = Astro.props;
---

<div class="tech-stack">
  {
    techStack.map((group) => (
      <div class="tech-stack-group">
        <h3 class="tech-stack-category">{group.category}</h3>
        <ul class="tech-stack-items">
          {group.items.map((slug) => (
            <li>
              <TechBadge slug={slug} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tech-stack-category {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-muted);
  }

  .tech-stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tech-stack-items li {
    display: flex;
  }
</style>
