---
// Contact enrichment (Identity & Polish nav pass): `location` and
// `resume` are both optional, additive to the original email/github/
// linkedin set. Composition revised at the same time — the section
// previously read as a bare row of links with no lead-in; it now opens
// with a quiet "Based in {city}" text line (when present) above the
// link row, and Resume, when present, joins that row as a fourth entry
// in the same icon+text visual language rather than a differently
// styled button — flagged in case a more visually distinct treatment
// (e.g. a standalone button) was intended for Resume specifically.
import { withBase } from '../lib/withBase';

interface Props {
  contact: {
    email?: string;
    github?: string;
    linkedin?: string;
    location?: string;
    resume?: string;
  };
}

const { contact } = Astro.props;

type ContactKind = 'email' | 'github' | 'linkedin' | 'resume';

const links: { kind: ContactKind; href: string; text: string }[] = [
  contact.email && { kind: 'email' as const, href: `mailto:${contact.email}`, text: contact.email },
  contact.github && { kind: 'github' as const, href: contact.github, text: 'GitHub' },
  contact.linkedin && { kind: 'linkedin' as const, href: contact.linkedin, text: 'LinkedIn' },
  contact.resume && { kind: 'resume' as const, href: withBase(contact.resume), text: 'Resume ↓' },
].filter((link): link is { kind: ContactKind; href: string; text: string } => Boolean(link));
---

<div class="contact">
  {contact.location && <p class="contact-location">Based in {contact.location}</p>}
  <ul class="contact-links">
    {
      links.map((link) => (
        <li>
          <a
            class="contact-link"
            href={link.href}
            target={link.kind === 'email' ? undefined : '_blank'}
            rel={link.kind === 'email' ? undefined : 'noopener noreferrer'}
          >
            {link.kind === 'email' && (
              <svg class="contact-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M1.5 4A1.5 1.5 0 0 1 3 2.5h10A1.5 1.5 0 0 1 14.5 4v8a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 12V4Zm1.63.5 4.4 3.3a.75.75 0 0 0 .94 0l4.4-3.3H3.13Zm10.37 1.13-4.3 3.23a2.25 2.25 0 0 1-2.7 0L3 5.63V12c0 .28.22.5.5.5h9a.5.5 0 0 0 .5-.5V5.63Z"
                />
              </svg>
            )}
            {link.kind === 'github' && (
              <svg class="contact-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                />
              </svg>
            )}
            {link.kind === 'linkedin' && (
              <svg class="contact-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <circle cx="2.1" cy="2.3" r="1.4" fill="currentColor" />
                <rect x="0.9" y="5.2" width="2.4" height="8.8" fill="currentColor" />
                <path
                  fill="currentColor"
                  d="M6 5.2h2.3v1.4c.5-.9 1.5-1.6 3-1.6 2.4 0 3.2 1.5 3.2 3.8V14h-2.4V9.2c0-1.1-.4-1.9-1.5-1.9-1.1 0-1.7.8-1.7 1.9V14H6.2V5.2H6Z"
                />
              </svg>
            )}
            {link.kind === 'resume' && (
              <svg class="contact-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M4 1.5A1.5 1.5 0 0 1 5.5 0h3.336c.398 0 .78.158 1.06.44l2.664 2.663c.281.281.44.663.44 1.061V14.5A1.5 1.5 0 0 1 11.5 16h-6A1.5 1.5 0 0 1 4 14.5v-13Zm1.5-.5a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5V5.5h-2.5A1.5 1.5 0 0 1 8 4V1H5.5Zm3.5.207V4a.5.5 0 0 0 .5.5h2.293L9 1.207Z"
                />
                <rect x="6" y="8" width="4" height="1" fill="currentColor" />
                <rect x="6" y="10.5" width="4" height="1" fill="currentColor" />
              </svg>
            )}
            <span>{link.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Plain text, not a link — author-authored prose (a city name), so it
     stays sans per the mono dosing rule's own test, same reasoning as
     the narrative meta sidebar's free-text rows. */
  .contact-location {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-1);
  }

  .contact-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-1);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-accent);
  }

  .contact-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .contact-icon {
    flex-shrink: 0;
  }
</style>
