---
import Switcher from './Switcher.svelte';
import CommandPalette from './CommandPalette.svelte';
import ThemeControl from './ThemeControl.svelte';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="shell-bar">
  <div class="shell-bar-leading">
    <CommandPalette client:load />
  </div>
  <Switcher client:load transition:persist="nav-switcher" initialPath={currentPath} />
  <div class="shell-bar-trailing">
    <ThemeControl client:load />
  </div>
</header>

<style>
  /* Hub folds into the switcher's first entry (2026-07-19 revision).
     2026-07-22: bar becomes a 3-column grid (1fr auto 1fr) so the
     switcher's center column stays mathematically centered against two
     equal side tracks — the palette trigger occupies the leading cell,
      Theme Control occupies the trailing cell. Reserving that cell empty ahead of time
     (2026-07-22) meant Theme Control's arrival needed no relayout. */
  .shell-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    align-self: stretch;
    width: 100%;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-base);
  }

  .shell-bar-leading {
    justify-self: start;
  }

  .shell-bar-trailing {
    justify-self: end;
  }
</style>
